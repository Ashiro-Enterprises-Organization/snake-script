# ============================================================
# 13. Algoritma — Bubble Sort
# ============================================================

tulis("[13] Algoritma — Bubble Sort")

fn urutkan(xs: Daftar<Angka>) -> Daftar<Angka>:
    let salinan = []
    for x in xs:
        salinan = salinan + [x]

    const n = panjang(salinan)
    let i = 0
    while i < n:
        let j = 0
        while j < n - i - 1:
            if salinan[j] > salinan[j + 1]:
                const t = salinan[j]
                salinan[j] = salinan[j + 1]
                salinan[j + 1] = t
            j += 1
        i += 1
    return salinan

const belum = [5, 2, 8, 1, 9, 3]
const sudah = urutkan(belum)
tulis("  sebelum: ${belum}")
tulis("  sesudah: ${sudah}")
tulis("")


# ============================================================
# 14. FizzBuzz
# ============================================================

tulis("[14] FizzBuzz")

for n in 1..16:
    if n % 15 == 0:
        tulis("  FizzBuzz")
    elif n % 3 == 0:
        tulis("  Fizz")
    elif n % 5 == 0:
        tulis("  Buzz")
    else:
        tulis("  ${n}")
tulis("")


# ============================================================
# 15. Bilangan Prima
# ============================================================

tulis("[15] Bilangan Prima")

fn prima(n: Angka) -> Boolean:
    if n < 2:
        return false
    if n == 2:
        return true
    if n % 2 == 0:
        return false
    let i = 3
    while i * i <= n:
        if n % i == 0:
            return false
        i += 2
    return true

let primaList = []
for n in 2..30:
    if prima(n):
        primaList = primaList + [n]
tulis("  prima < 30: ${primaList}")
tulis("")


