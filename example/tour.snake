tulis("")


# ============================================================
# 9. Match
# ============================================================

tulis("[9] Match")

fn klasifikasi(n: Angka) -> Teks:
    match n:
        case 0:
            return "nol"
        case 1 | 2 | 3:
            return "kecil"
        case _:
            return "besar"

for n in [0, 2, 5, 100]:
    tulis("  klasifikasi(${n}) = ${klasifikasi(n)}")
tulis("")


# ============================================================
# 10. Error Handling
# ============================================================

tulis("[10] Error Handling")

fn bagi(a: Angka, b: Angka) -> Angka:
    if b == 0:
        throw Error("tidak bisa bagi dengan nol")
    return a / b

try:
    tulis("  bagi(10, 2) = ${bagi(10, 2)}")
    tulis("  bagi(10, 0) = ${bagi(10, 0)}")
catch err:
    tulis("  Error tertangkap: ${err.message}")
finally:
    tulis("  Blok finally selalu jalan")
tulis("")


