tulis("  daftar: ${angka}")
tulis("  panjang: ${panjang(angka)}")
tulis("  index 0: ${angka[0]}")
tulis("  index 4: ${angka[4]}")

let mutable = [1, 2, 3]
mutable[0] = 100
tulis("  setelah mutable[0] = 100: ${mutable}")

const umur = { "budi": 20, "ani": 22, "cici": 19 }
tulis("  umur[budi] = ${umur['budi']}")
