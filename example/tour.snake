# ============================================================
# 5. Loop
# ============================================================

tulis("[5] Loop")

tulis("  While:")
let i = 0
while i < 3:
    tulis("    i = ${i}")
    i += 1

tulis("  For over range:")
for j in 0..5:
    tulis("    j = ${j}")

tulis("  For over list:")
for x in [10, 20, 30]:
    tulis("    x = ${x}")

tulis("  Break & continue:")
for k in 0..10:
    if k == 3:
        continue
    if k == 7:
        break
    tulis("    k = ${k}")
tulis("")


# ============================================================
# 6. Fungsi
# ============================================================

tulis("[6] Fungsi")

fn tambah(a: Angka, b: Angka) -> Angka:
    return a + b

tulis("  tambah(3, 4) = ${tambah(3, 4)}")

fn faktorial(n: Angka) -> Angka:
    if n <= 1:
        return 1
    return n * faktorial(n - 1)

tulis("  faktorial(5) = ${faktorial(5)}")
tulis("  faktorial(10) = ${faktorial(10)}")

fn fibonacci(n: Angka) -> Angka:
    if n <= 1:
        return n
    return fibonacci(n - 1) + fibonacci(n - 2)

tulis("  fibonacci(10) = ${fibonacci(10)}")
tulis("")


# ============================================================
# 7. Closure & Higher-Order
# ============================================================

tulis("[7] Closure & Higher-Order Function")

fn buatPengali(faktor: Angka) -> (Angka) -> Angka:
    return fn(x: Angka) -> Angka => x * faktor

const kali2 = buatPengali(2)
const kali10 = buatPengali(10)

tulis("  kali2(5) = ${kali2(5)}")
tulis("  kali10(5) = ${kali10(5)}")

fn petakan(xs: Daftar<Angka>, f: (Angka) -> Angka) -> Daftar<Angka>:
    let hasil = []
    for x in xs:
        hasil = hasil + [f(x)]
    return hasil

const digandakan = petakan([1, 2, 3, 4], kali2)
tulis("  petakan([1,2,3,4], kali2) = ${digandakan}")
tulis("")


