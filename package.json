{
  "name": "snake-script",
  "version": "0.1.0",
  "description": "Kemudahan Python. Keamanan TypeScript. Bahasa pemrograman dengan sintaks sederhana dan sistem tipe statis yang ketat.",
  "keywords": [
    "programming-language",
    "language",
    "interpreter",
    "compiler",
    "type-system",
    "static-typing",
    "snake-script",
    "ashiros"
  ],
  "license": "MIT",
  "author": "Ashiro Enterprises <dev@ashiro.dev> (https://github.com/Ashiro-Enterprises-Organization)",
  "contributors": [
    "Snake Script Contributors"
  ],
  "homepage": "https://github.com/Ashiro-Enterprises-Organization/snake-script#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashiro-Enterprises-Organization/snake-script.git"
  },
  "bugs": {
    "url": "https://github.com/Ashiro-Enterprises-Organization/snake-script/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Ashiro-Enterprises-Organization"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "snake": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lexer": {
      "types": "./dist/lexer.d.ts",
      "import": "./dist/lexer.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/parser.js"
    },
    "./analyzer": {
      "types": "./dist/analyzer.d.ts",
      "import": "./dist/analyzer.js"
    }
  },
  "files": [
    "dist",
    "stdlib",
    "docs/SPEC.md",
    "docs/GRAMMAR.ebnf",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node ./dist/cli.js",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run clean && npm run check && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.4.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {},
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 90,
    "tabWidth": 2
  }
}
